+TimeClamper::TimeClamper() : secret_([] {
+  // A persona uses one process-stable quantizer secret so navigation, paint,
+  // event and resource timing share identical rounding boundaries. The
+  // unconfigured path retains Chromium's per-process random secret.
+  uint32_t seed = 0;
+  base::StringToUint(base::UxrConfig::GetInstance().Get("uxr-canvas-seed"),
+                     &seed);
+  if (seed != 0) {
+    uint64_t x = seed;
+    x ^= x >> 33;
+    x *= uint64_t{0xff51afd7ed558ccd};
+    x ^= x >> 33;
+    x *= uint64_t{0xc4ceb9fe1a85ec53};
+    x ^= x >> 33;
+    return x;
+  }
+  return base::RandUint64();
+}()) {}
 
