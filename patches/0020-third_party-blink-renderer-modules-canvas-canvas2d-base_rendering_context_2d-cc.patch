 #include "third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.h"
 
+#include <cstdlib>  // UXR
+#include <cstring>  // UXR: memcpy for half-float bits
+#include "base/command_line.h"  // UXR
+#include "base/strings/string_number_conversions.h"  // UXR
