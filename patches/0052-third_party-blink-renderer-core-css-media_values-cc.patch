@@ -641,7 +697,23 @@
 mojom::blink::PointerType MediaValues::CalculatePrimaryPointerType(
     LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  {  // UXR: persona primary pointer. A touchscreen host reports coarse here
+    // (and coarse in any-pointer) — the desktop persona must say fine, in
+    // lockstep with uxr-max-touch-points.
+    const std::string ph_v = base::UxrConfig::GetInstance().Get("uxr-pointer");
+    const std::string ph_persona =
+        base::UxrConfig::GetInstance().Get("uxr-platform");
+    const bool ph_desktop =
+        base::EqualsCaseInsensitiveASCII(ph_persona, "windows") ||
+        base::EqualsCaseInsensitiveASCII(ph_persona, "win32");
+    if (ph_v == "coarse")
+      return mojom::blink::PointerType::kCoarse;
+    if (ph_v == "none")
+      return mojom::blink::PointerType::kNone;
+    if (ph_v == "fine" || ph_desktop)
+      return mojom::blink::PointerType::kFine;
+  }
   return frame->GetSettings()->GetPrimaryPointerType();
 }
 
@@ -651,6 +723,23 @@
 int MediaValues::CalculateAvailablePointerTypes(LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  {  // UXR: keep any-pointer coherent with the primary pointer above.
+    // blink::PointerType shares bit values with ui::PointerType
+    // (NONE=1, COARSE=2, FINE=4) per the static asserts in
+    // web_preferences.cc.
+    const std::string ph_v = base::UxrConfig::GetInstance().Get("uxr-pointer");
+    const std::string ph_persona =
+        base::UxrConfig::GetInstance().Get("uxr-platform");
+    const bool ph_desktop =
+        base::EqualsCaseInsensitiveASCII(ph_persona, "windows") ||
+        base::EqualsCaseInsensitiveASCII(ph_persona, "win32");
+    if (ph_v == "coarse")
+      return static_cast<int>(mojom::blink::PointerType::kCoarse);
+    if (ph_v == "none")
+      return static_cast<int>(mojom::blink::PointerType::kNone);
+    if (ph_v == "fine" || ph_desktop)
+      return static_cast<int>(mojom::blink::PointerType::kFine);
+  }
   return frame->GetSettings()->GetAvailablePointerTypes();
 }
 
